COMPOSE_PROJECT_NAME=emerti-backend

# Application Configurations
APP_PORT=6969

# DB Configurations
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=5432

# Redis Configurations
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_PREFIX=emerti:session:

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# File Browser Credentials
FILEBROWSER_PW=your_filebrowser_password

# MQTT Configurations — Primary
MQTT_BROKER=your_mqtt_broker_host
MQTT_PORT=1883

# MQTT Configurations — Secondary (optional; leave empty to run single-MQTT without warnings)
MQTT2_BROKER=
MQTT2_PORT=1883

# =========================================================================
# TELEGRAM CS & SLA HELPDESK BOT INTEGRATION
# =========================================================================
# Token bot dari BotFather di Telegram (contoh: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=
# Chat ID grup Telegram NOC/Helpdesk tempat Atasan & Tim Support memantau (contoh: -1001234567890)
TELEGRAM_SUPPORT_CHAT_ID=
# Opsional: Jika menggunakan Webhook dengan domain publik/HTTPS. Kosongkan jika ingin mode Polling otomatis (rekomendasi: kosongkan)
TELEGRAM_WEBHOOK_URL=
# Base URL backend untuk tautan lampiran/attachment (default: http://localhost:6969)
APP_BASE_URL=http://localhost:6969
# Base URL frontend portal web untuk tombol "Buka di Web" (default: http://localhost:3000)
WEB_PORTAL_URL=http://localhost:3000
