# EMERTI Command Center — backend stack configuration
#
# Copy to `.env` and edit. Loaded explicitly with --env-file; Compose also picks
# it up automatically because it sits next to docker-compose.yml.
#
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d --build

# ─── Compose ────────────────────────────────────────────────────────────────
# Must stay distinct from the legacy stack (emerti-fms) or the two will fight
# over container and volume names.
COMPOSE_PROJECT_NAME=emerti-cc

# ─── Host ports ─────────────────────────────────────────────────────────────
# Deliberately offset from the legacy stack so both can run at once.
API_HOST_PORT=6969
DB_HOST_PORT=6667
REDIS_HOST_PORT=6380

# ─── Application ────────────────────────────────────────────────────────────
# development enables gin debug logging; production enables ReleaseMode.
APP_ENV=production

# ─── Database (TimescaleDB / PostgreSQL 17) ─────────────────────────────────
DB_NAME=emerti_db
DB_USER=emerti
DB_PASSWORD=emerti_dev_password

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=emertiRedis2026!
REDIS_PREFIX=emerti:session:

# ─── Security ───────────────────────────────────────────────────────────────
# Generate a real secret before any deployment that is not a local sandbox:
#   openssl rand -hex 32
JWT_SECRET=450542235a72l6u59g86ar2498597a927367e60657820679e9fd21a1298196c4
FILEBROWSER_PW=NVuIev7LvidSU4Bu

# ─── MQTT brokers ───────────────────────────────────────────────────────────
# External to the stack. If a broker is unreachable the API still starts and
# retries the connection in the background, so a wrong value degrades rather
# than breaks the service.
MQTT_BROKER=103.103.20.19
MQTT_PORT=1883
MQTT2_BROKER=103.150.194.254
MQTT2_PORT=1883